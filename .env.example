SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
DATA_ROOT=./data
DB_USERNAME=sa
DB_PASSWORD=

# Optional model defaults. Generation and embeddings use independent settings.
GENERATION_PROVIDER=OLLAMA
GENERATION_BASE_URL=http://127.0.0.1:11434
GENERATION_MODEL=gemma4:e2b
GENERATION_TIMEOUT_MS=60000
GENERATION_TEMPERATURE=0.2
GENERATION_MAX_TOKENS=1200
EMBEDDING_PROVIDER=OLLAMA
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_MS=60000
# For OpenAI compatible services, set API key in the process environment.
# Do not put a real key in this file. The model settings store only this name.
GENERATION_API_KEY_ENV=OPENAI_API_KEY
EMBEDDING_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=
